    <string name="gesture_max_distance_title">Khoảng cách tối đa</string>
    <string name="gesture_max_distance_desc" formatted="false">Ranh giới ngắn/dài (% đường chéo phím): bằng hoặc nhỏ hơn = vuốt ngắn, lớn hơn = từ được gõ vuốt. Giá trị thấp biến những lần trượt nhẹ thành từ; giá trị cao yêu cầu vuốt dài hơn trước khi bắt đầu gõ từ.</string>
    <string name="gesture_vertical_threshold_title">Ngưỡng dọc</string>
    <string name="gesture_vertical_threshold_desc" formatted="false">% chiều cao phím ngón tay phải di chuyển để kích hoạt chọn dòng. Cao hơn = khó chọn dòng vô tình hơn.</string>
    <string name="gesture_vertical_speed_title">Tốc độ dọc</string>
    <string name="gesture_vertical_speed_desc">Hệ số tốc độ cho việc chọn dòng (thấp hơn = chậm hơn). Chọn ký tự vẫn ở tốc độ đầy đủ.</string>
    <string name="gesture_tap_duration_title">Ngưỡng thời lượng chạm</string>
    <string name="gesture_tap_duration_desc">Thời lượng tối đa cho cử chỉ chạm (ms). Cao hơn = dễ chạm hơn nhưng có thể ảnh hưởng đến vuốt.</string>
    <string name="gesture_double_space_period_title">Nhấn kép Space thành dấu chấm</string>
