    <string name="swipe_engine_mode_title">Công cụ dự đoán</string>
    <string name="swipe_engine_mode_desc">CTC: sử dụng CTC trên thiết bị khi ngôn ngữ và bố cục đã chọn được hỗ trợ; xem trạng thái của cấu hình này ở bên dưới. Hình học: dùng được với mọi bố cục.</string>
