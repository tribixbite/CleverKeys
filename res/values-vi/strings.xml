    <string name="gesture_double_space_timing_title">Thời gian nhấn kép Space</string>
    <string name="gesture_double_space_timing_desc">Thời gian tối đa giữa hai lần Space để kích hoạt dấu chấm (ms)</string>
    <string name="gesture_sensitivity_preset_title">Cài đặt trước độ nhạy</string>
    <string name="gesture_sensitivity_preset_desc">Cài đặt trước nhanh cho nhận dạng vuốt. Tùy chỉnh hiển thị khi giá trị khác cài đặt trước.</string>
    <string name="gesture_min_swipe_distance_title">Khoảng cách vuốt tối thiểu</string>
    <string name="gesture_min_swipe_distance_desc">Đường di chuyển tối thiểu (px) trước khi cử chỉ có thể là từ gõ vuốt. Thấp hơn giúp đăng ký các từ rất ngắn; tăng nếu chạm vô tình kích hoạt từ. (Ngắn hay dài được quyết định bởi Khoảng cách tối đa ở trên.)</string>
    <string name="gesture_min_key_distance_title">Khoảng cách phím tối thiểu</string>
    <string name="gesture_min_key_distance_desc">Khoảng cách giữa các phím khi vuốt (px). Thấp hơn nhận nhiều phím hơn nhưng có thể thêm nhiễu.</string>
    <string name="gesture_min_key_dwell_title">Thời gian dừng phím tối thiểu</string>
