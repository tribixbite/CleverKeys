    <string name="gesture_touch_smoothing_desc">Số điểm dùng cho trung bình trượt của đường vuốt. 1 = dữ liệu thô, 3 = khuyến nghị. Áp dụng cho cả hai bộ máy.</string>
    <string name="swipe_engine_fallback_title">Sẽ dùng bộ máy hình học</string>
