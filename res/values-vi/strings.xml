    <string name="gesture_noise_filter_title">Bộ lọc nhiễu chuyển động</string>
    <string name="gesture_noise_filter_desc">Chuyển động tối thiểu để đăng ký (px). Cao hơn lọc rung nhưng có thể mất dữ liệu.</string>
    <string name="gesture_high_velocity_title">Ngưỡng vận tốc cao</string>
