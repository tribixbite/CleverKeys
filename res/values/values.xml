<?xml version="1.0" encoding="utf-8"?>
<resources>
  <dimen name="margin_top">3dp</dimen>
  <dimen name="key_padding">2dp</dimen>
  <dimen name="emoji_text_size">28dp</dimen>
  <dimen name="pref_button_size">28dp</dimen>
  <!-- Will be overwritten automatically by Gradle for the debug build variant -->
  <bool name="debug_logs">false</bool>
  <!-- View tag: a content pane's own padding before WindowLayoutUtils.keepPaneClearOfSideInsets
       added the side insets, so reinstalling on the cached clipboard pane never accumulates. -->
  <item type="id" name="pane_base_padding"/>
  <!-- TalkBack custom-action ids, one per short-swipe direction (a11y/ShortSwipeAccessibilityActions).
       App-defined accessibility actions must use resource ids so they never collide with the
       framework's standard action ids. -->
  <item type="id" name="a11y_short_swipe_n"/>
  <item type="id" name="a11y_short_swipe_ne"/>
  <item type="id" name="a11y_short_swipe_e"/>
  <item type="id" name="a11y_short_swipe_se"/>
  <item type="id" name="a11y_short_swipe_s"/>
  <item type="id" name="a11y_short_swipe_sw"/>
  <item type="id" name="a11y_short_swipe_w"/>
  <item type="id" name="a11y_short_swipe_nw"/>
  <!-- Clipboard Pinned / To-dos reordering (2026-10-27): TalkBack custom-action ids for the
       row's "Move up", "Move down" and "Move to top" (ClipboardHistoryView). -->
  <item type="id" name="clipboard_entry_move_up"/>
  <item type="id" name="clipboard_entry_move_down"/>
  <item type="id" name="clipboard_entry_move_top"/>
</resources>
