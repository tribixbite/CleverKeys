<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android Auto Backup (API 23-30).

  PRIVACY-FIRST APPROACH: only aesthetic/visual SharedPreferences are backed up.
  User data, learning samples, and privacy-sensitive data stay on-device only.

  ALLOWLIST SEMANTICS (important):
  Because this file declares <include> entries, Auto Backup switches to
  allowlist mode: ONLY the explicitly <include>-ed paths are backed up and
  EVERYTHING ELSE is excluded automatically. There is therefore no need (and
  it is invalid per the schema) to also <exclude> paths that are not under an
  <include> — a stray <exclude> on an un-included path is a Fatal lint error
  (FullBackupContent). The previous mix of <include> + orphan <exclude>s is
  replaced by a pure allowlist below; the resulting backup surface is identical
  in intent and strictly tighter.

  What IS backed up (the only 3 SharedPreferences files listed below):
  - custom_theme_prefs.xml   custom theme definitions
  - material_theme_prefs.xml Material You / dynamic-color settings
  - emoji_last_use.xml       recently-used emoji ordering (non-PII)

  What is NOT backed up (implicitly excluded by allowlist mode):
  - The main settings file (tribixbite.cleverkeys_preferences.xml) and all
    other SharedPreferences (privacy_settings, personalization/adaptation,
    user_dictionary, swipe selection stats, bigram store, etc.)
  - ALL databases (clipboard history, ML training data)
  - ALL files (short_swipe_customizations.json, clipboard_media/, everything)
-->
<full-backup-content>
    <!-- Aesthetic SharedPreferences only. Everything not listed is excluded. -->
    <include domain="sharedpref" path="custom_theme_prefs.xml" />
    <include domain="sharedpref" path="material_theme_prefs.xml" />
    <include domain="sharedpref" path="emoji_last_use.xml" />
</full-backup-content>
