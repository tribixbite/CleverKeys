<?xml version="1.0" encoding="utf-8"?>
<row height="0.95">
  <!-- Swipe up on Ctrl opens the number pane (123+). It replaced "ABC" (switch_back_clipboard),
       which only closed an open pane; each pane closes with its own button or its opener key. -->
  <key width="1.7" key0="ctrl" key1="loc switch_greekmath" key2="loc meta" key3="loc switch_clipboard" key7="switch_numeric"/>
  <key width="1.1" key0="fn" key1="loc alt" key2="loc change_method" key3="switch_emoji" key4="config" key6="loc toggle_true_black" key7="switch_gif"/>
  <!-- #169: switch_forward/switch_backward are `loc` so the extra-keys checkboxes govern
       them (defaultChecked=true keeps them visible for multi-layout users by default;
       LayoutModifier still hides them when only one layout is enabled). -->
  <key width="4.4" key0="space" key7="loc switch_forward" key8="loc switch_backward" key5="cursor_left" key6="cursor_right"/>
  <key width="1.1" key0="loc compose" key7="up" key6="right" key5="left" key8="down" key1="doc_home" key2="loc page_up" key3="doc_end" key4="loc page_down"/>
  <key width="1.7" key0="enter" key1="loc voice_typing" key2="action"/>
</row>
