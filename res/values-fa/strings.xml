    <string name="input_learning_aggression_desc">چقدر عادت‌ها بر پیش‌بینی‌ها تأثیر می‌گذارند</string>
    <string name="input_context_boost_title">ضریب تقویت زمینه</string>
    <string name="input_context_boost_desc">چقدر زمینه بر پیش‌بینی‌ها تأثیر می‌گذارد (۰٫۵ تا ۵٫۰)</string>
