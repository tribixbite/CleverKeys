<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"><!-- Overdraw: #1e1e1e is now painted by swipeDebugTheme's windowBackground; root bg removed to avoid double-paint. -->

    <!-- Top bar with back arrow, title, and action icons -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:background="#2d2d2d"
        android:elevation="4dp">

        <!-- Back arrow -->
        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/debug_back"
            android:scaleType="centerInside"
            android:padding="12dp"
            app:tint="#ffffff" />

        <!-- Title (debug-only screen; title string is translatable=false so
             localized expansion into clear_button cannot occur). -->
        <TextView
            android:id="@+id/title_text"
            tools:ignore="RelativeOverlap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/back_button"
            android:layout_centerVertical="true"
            android:text="@string/debug_swipe_log_title"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Save to file icon -->
        <ImageButton
            android:id="@+id/save_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_save"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/debug_save_to_file"
            android:scaleType="centerInside"
            android:padding="12dp"
            app:tint="#ffffff" />

        <!-- Copy to clipboard icon -->
        <ImageButton
            android:id="@+id/copy_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_toStartOf="@id/save_button"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_content_copy"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/debug_copy_to_clipboard"
            android:scaleType="centerInside"
            android:padding="12dp" />

        <!-- Clear logs icon -->
        <ImageButton
            android:id="@+id/clear_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_toStartOf="@id/copy_button"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/debug_clear_logs"
            android:scaleType="centerInside"
            android:padding="12dp"
            app:tint="#ffffff" />
    </RelativeLayout>

    <!-- Text input field - single line, scrollable, shows keyboard output -->
    <HorizontalScrollView
        android:id="@+id/input_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2d2d2d"
        android:scrollbars="horizontal">

        <EditText
            android:id="@+id/input_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="300dp"
            android:hint="@string/debug_input_hint"
            android:textColor="#ffffff"
            android:textColorHint="#808080"
            android:background="@android:color/transparent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:inputType="text"
            android:importantForAutofill="no"
            android:textSize="16sp"
            android:maxLines="1"
            android:singleLine="true"
            android:gravity="start|center_vertical"
            android:imeOptions="actionDone|flagNoExtractUi" />
    </HorizontalScrollView>

    <!-- Divider line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4a4a4a" />

    <!-- Swipe Playground result panel (2026-09-03): committed word, engine/latency meta,
         and the live candidate ranking with scores for the LAST swipe. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#232323"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/result_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_result_placeholder"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/result_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/debug_meta_placeholder"
            android:textColor="#9e9e9e"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/candidates_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#8ec9ff"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Trace-recording controls: count, JSON export + share, playground clear. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2d2d2d"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/trace_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/debug_trace_count_placeholder"
            android:textColor="#c0c0c0"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/export_traces_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/debug_export_traces"
            android:textColor="#80cbc4"
            android:textSize="13sp" />

        <Button
            android:id="@+id/clear_traces_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/debug_clear_traces"
            android:textColor="#ef9a9a"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Privacy disclosure: playground-local recording, contains typed content. -->
    <TextView
        android:id="@+id/privacy_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2d2d2d"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/debug_privacy_note"
        android:textColor="#ffcc80"
        android:textSize="11sp" />

    <!-- Divider line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4a4a4a" />

    <!-- Scrollable log output - takes remaining space -->
    <ScrollView
        android:id="@+id/log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="8dp"
        android:background="#1a1a1a">

        <TextView
            android:id="@+id/log_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_waiting_input"
            android:textColor="#00ff00"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
