    <string name="gesture_finger_occlusion_desc" formatted="false">Offset-Y sebagai % tinggi baris untuk mengompensasi jari yang menghalangi tombol. Lebih tinggi menggeser titik sentuh ke bawah menuju pusat tombol.</string>
