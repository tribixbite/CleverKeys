    <string name="gesture_max_distance_title">Jarak Maksimum</string>
    <string name="gesture_max_distance_desc" formatted="false">Batas pendek/panjang (% diagonal tombol): di bawah atau sama dengan = geser pendek, melewati = kata geser. Nilai rendah mengubah sedikit gerakan menjadi kata; nilai tinggi membutuhkan geser lebih panjang.</string>
