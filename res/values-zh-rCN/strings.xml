    <string name="input_context_source_title">上下文来源</string>
    <string name="input_context_source_desc">用于增强预测的短语模型：内置模型、你学习到的规律，或两者。</string>
    <string name="input_personalization_weight_title">个性化强度</string>
    <string name="input_personalization_weight_desc">你的用词习惯对预测的增强程度（0 = 关闭，2 = 双倍）。</string>
    <string name="input_personalization_max_words_title">学习词数上限</string>
    <string name="input_personalization_max_words_desc">已学习词汇量的上限；价值最低的词会被优先移除（默认 5000）。</string>
    <string name="privacy_on_device_learning_title">从我的输入中学习</string>
    <string name="privacy_on_device_learning_desc">根据你输入的内容，在设备本地构建私密的短语和用词模型。关闭后将停止一切对输入行为的自动记录——关闭期间不会存储任何新数据。你主动创建的数据不在此列：你运行的滑行校准会话、预测性能统计，以及从备份恢复的学习数据。</string>
    <!-- v1.6 swipe diagnostics and controls -->
    <string name="dict_word_too_long_for_swipe_title">已添加，但太长而无法滑行输入</string>
    <plurals name="dict_word_too_long_for_swipe_msg"><item quantity="other">“%1$s”已添加，可用于点按输入；但 CTC 需要 %2$d 步，最多只能解码 %3$d 步。</item></plurals>
    <string name="gesture_finger_occlusion_title">触摸偏移校正</string>
    <string name="gesture_finger_occlusion_desc">调整相对于指尖读取滑行轨迹的位置。轨迹高于目标按键时使用正值，低于按键时使用负值。默认关闭。</string>
    <string name="gesture_touch_smoothing_title">触摸平滑</string>
    <string name="gesture_touch_smoothing_desc">用于轨迹移动平均的点数。1 = 原始输入，3 = 推荐值。适用于两种引擎。</string>
    <string name="swipe_engine_fallback_title">将使用几何引擎</string>
    <string name="swipe_engine_fallback_desc">CTC 没有 %1$s 的词典，因此将由几何引擎解码滑行轨迹。CTC 当前支持：%2$s。</string>
    <string name="collision_warning_title">发现缩写冲突</string>
    <plurals name="collision_warning_body"><item quantity="other">导入语言包中的 %1$d 个快捷形式可能改写另一个启用语言（%2$s）中的真实单词。现已改为可选建议。</item></plurals>
    <string name="collision_warning_examples">受影响的快捷形式：</string>
    <string name="swipe_context_rescoring_title">使用上下文排列滑行建议</string>
    <string name="swipe_context_rescoring_desc">使用已在此设备上输入的词对重新排列建议。只处理接近的结果，不会覆盖明确识别的滑行。需要启用设备端学习。</string>
</resources>
