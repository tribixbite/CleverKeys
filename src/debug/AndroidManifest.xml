<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Test-only Activity: hosts clipboard views for instrumented Espresso testing.
             Compiled into debug APK only — not included in release builds. -->
        <activity
            android:name="tribixbite.cleverkeys.ClipboardEditTestActivity"
            android:exported="false" />
        <!-- Test-only text fields for instrumented tests of the real keyboard (rotation, layout
             switches). The first is recreated by a rotation like most apps; the second keeps its
             window. Debug APK only. -->
        <activity
            android:name="tribixbite.cleverkeys.ImeFieldTestActivity"
            android:exported="false" />
        <activity
            android:name="tribixbite.cleverkeys.ImeFieldKeepWindowTestActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false" />
    </application>
</manifest>
