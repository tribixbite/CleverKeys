<?xml version="1.0" encoding="utf-8"?>
<!-- No explicit width: the keyboard is as wide as its rows (4.0 units), so the keys fill it.
     #58 removed width="6.0" (a dead right-hand column); 2026-11-18 removed the shift="1.0"
     each row's first key carried, which left the keyboard's left fifth empty. -->
<keyboard bottom_row="false" numpad_height="true">
  <row>
    <key key0="1"/>
    <key key0="2" indication="ABC"/>
    <key key0="3" indication="DEF"/>
    <key key0="backspace" key2="delete"/>
  </row>
  <row>
    <key key0="4" indication="GHI"/>
    <key key0="5" indication="JKL"/>
    <key key0="6" indication="MNO"/>
    <key key0="(" key1="paste" key2="=" key3=":" key4="-"/>
  </row>
  <row>
    <key key0="7" indication="PQRS"/>
    <key key0="8" indication="TUV"/>
    <key key0="9" indication="WXYZ"/>
    <key key0=")" key2="," key3="/" key4="."/>
  </row>
  <row>
    <key key0="*" key1="switch_text" key3="switch_numeric"/>
    <key key0="0" key3="+" key4="space"/>
    <key key0="\#" key7="up" key6="right" key5="left" key8="down"/>
    <key key0="action" key2="enter"/>
  </row>
</keyboard>
