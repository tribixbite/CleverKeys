<?xml version="1.0" encoding="utf-8"?>
<keyboard name="Central Kurdish (سۆرانی) Persian Layout" script="arabic" numpad_script="hindu-arabic" bottom_row="false">
  <row>
    <key key0="،" key7="esc" key4="delete" />
    <key key0="." key1="&lt;" key4="&gt;" />
    <key key0="ە" key1="(" key4=")" />
    <key key0="ق" key7=":" key8="*" />
    <key key0="ف" key7="؟" key8="+" />
    <key key0="ۆ" key7="!" key8="ۊ" />
    <key key0="ع" key7="غ" key8="_" />
    <key key0="ھ" key7="٪" key8="ه" />
    <key key0="خ"  key3="[" key2="]" />
    <key key0="ح" key3="{" key2="}" />
    <key key0="ج" key3="backspace" key7="halfspace" />
  </row>
  <!-- Hamza letters (maintainer decision 2026-10-25): أ and إ on the free top-left / bottom-left
       corners of ا (as arab_pc.xml and arab_hamvaj_tly.xml place them), ؤ on the top-left of و. -->
  <row>
    <key key0="ش" key7="١" key8="ض" />
    <key key0="س" key7="٢" key8="ص" />
    <key key0="ی" key7="٣" key8="ؽ" />
    <key key0="ب" key7="٤" key8="ٮ" />
    <key key0="ل" key7="٥" key8="ڵ" />
    <key key0="ا" key7="٦" key8="آ" key1="أ" key3="إ" />
    <key key0="ت" key7="٧" key8="ط" />
    <key key0="ن" key7="٨" key8="-" />
    <key key0="م" key7="٩" key8="=" />
    <key key0="ک" key7="٠" key8="ك" />
    <key key0="گ" key7="tab" />
  </row>
  <row>
    <key key0="ڕ" key7="&#1563;" />
    <key key0="ژ" key7="ـ" />
    <key key0="ز" key7="ظ" />
    <key key0="ر" key7="ٔ" />
    <key key0="ڤ" key7="ڡ" />
    <key key0="د" key7="ذ" />
    <key key0="پ" key7="ث" />
    <key key0="و" key7="ۉ" key1="ؤ" />
    <key key0="ێ" key7="ٕ" />
    <key key0="ئ" key7="ء" />
    <key key0="چ" />
  </row>
  <!-- Own copy of res/xml/bottom_row.xml (bottom_row="false" above) so the half-space key can sit
       right of the space bar, as on AOSP, HeliBoard and FUTO (docs/research/2026-10-21-persian-zwnj.md
       §1, §7a). Keep the other keys in sync with res/xml/bottom_row.xml. Swipe up on it for ZWJ. -->
  <row height="0.95">
    <key width="1.7" key0="ctrl" key1="loc switch_greekmath" key2="loc meta" key3="loc switch_clipboard" key4="switch_numeric" key7="switch_back_clipboard"/>
    <key width="1.1" key0="fn" key1="loc alt" key2="loc change_method" key3="switch_emoji" key4="config" key7="switch_gif"/>
    <key width="4.4" key0="space" key7="loc switch_forward" key8="loc switch_backward" key5="cursor_left" key6="cursor_right"/>
    <key width="1.0" key0="halfspace" key7="zwj"/>
    <key width="1.1" key0="loc compose" key7="up" key6="right" key5="left" key8="down" key1="doc_home" key2="loc page_up" key3="doc_end" key4="loc page_down"/>
    <key width="1.7" key0="enter" key1="loc voice_typing" key2="action"/>
  </row>
</keyboard>
