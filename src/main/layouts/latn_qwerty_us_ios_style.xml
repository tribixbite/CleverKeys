<?xml version="1.0" encoding="utf-8"?>
<!-- QWERTY (iOS-style): a US-English letter pane laid out like the default iPhone
keyboard (iOS 26, portrait). Layout only: "iOS-style" describes the arrangement; this
layout is not affiliated with or endorsed by Apple, and copies no artwork or fonts.

Reference: Apple's "Type with the onscreen keyboard on iPhone" guide
(https://support.apple.com/guide/iphone/type-with-the-onscreen-keyboard-iph3c50f96e/ios).

What is mimicked:
- three letter rows with no number row and no symbol hints on the letters;
- the second row indented by half a key;
- Shift and Delete about 1.25 keys wide, separated from Z and M by a quarter-key gap;
- bottom row "123 | emoji | space | return" at 1.25 / 1.25 / 5 / 2.5 key widths.

How the iOS features map onto CleverKeys keys:
- 123 is `switch_numeric` with a "123" label. It opens CleverKeys' own number pane; the
  iOS 123 / #+= symbol panes cannot be expressed by a layout file.
- The globe and dictation buttons iOS draws BELOW the keyboard become `loc change_method`
  and `loc voice_typing` corners (shown when their Extra Keys checkbox is on, the default).
- iOS's press-and-hold-space trackpad maps to the space bar's cursor_left / cursor_right
  slide; iOS's press-and-hold accent popups map to the `loc` slots, which a language's
  extra keys fill in.
- Ctrl, Fn, settings, clipboard, GIF and the arrow keys from CleverKeys' standard bottom
  row stay reachable as corner swipes on the bottom-row keys, Shift and Delete, so no
  letter key carries a visible corner symbol by default.
-->
<keyboard name="QWERTY (iOS-style)" script="latin" bottom_row="false">
  <row>
    <key c="q"/>
    <key c="w"/>
    <key c="e" se="loc €"/>
    <key c="r"/>
    <key c="t"/>
    <key c="y"/>
    <key c="u"/>
    <key c="i"/>
    <key c="o"/>
    <key c="p"/>
  </row>
  <row>
    <key shift="0.5" c="a"/>
    <key c="s" sw="loc ß"/>
    <key c="d"/>
    <key c="f"/>
    <key c="g"/>
    <key c="h"/>
    <key c="j"/>
    <key c="k"/>
    <key c="l"/>
  </row>
  <row>
    <key width="1.25" c="shift" nw="home" ne="end" se="loc tab" sw="loc capslock"/>
    <key shift="0.25" c="z"/>
    <key c="x" ne="loc †"/>
    <key c="c"/>
    <key c="v"/>
    <key c="b"/>
    <key c="n"/>
    <key c="m"/>
    <key shift="0.25" width="1.25" c="backspace" nw="delete_last_word" ne="delete" sw="loc esc" se="loc menu" n="loc page_up" s="loc page_down"/>
  </row>
  <row height="0.95">
    <key width="1.25" c="123:switch_numeric" nw="ctrl" ne="fn" sw="loc switch_greekmath" se="loc meta" n="loc alt" s="loc compose"/>
    <key width="1.25" c="switch_emoji" nw="loc change_method" ne="config" sw="loc switch_clipboard" se="switch_gif" n="switch_back_clipboard"/>
    <key width="5" c="space" n="loc switch_forward" s="loc switch_backward" w="cursor_left" e="cursor_right"/>
    <key width="2.5" c="enter" nw="loc voice_typing" ne="action" n="up" s="down" w="left" e="right" sw="doc_home" se="doc_end"/>
  </row>
</keyboard>
