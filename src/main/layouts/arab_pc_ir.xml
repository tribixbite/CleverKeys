<?xml version="1.0" encoding="utf-8"?>
<keyboard name="Persian PC" script="persian" language="fa" bottom_row="false">
  <row>
    <key key0="ض" key2="۱" key4="loc esc"/>
    <key key0="ص" key2="۲" key1="~" key3="\@"/>
    <key key0="ث" key2="۳" key1="!" key3="\#"/>
    <key key0="ق" key2="۴" key1="﷼" key3="$"/>
    <key key0="ف" key2="۵" key3="٪"/>
    <key key0="غ" key2="۶" key1="،" key3="^"/>
    <key key0="ع" key2="۷" key3="&amp;"/>
    <key key0="ه" key2="۸" key3="*"/>
    <key key0="خ" key2="۹" key3="(" key4=")"/>
    <key key0="ح" key2="۰"/>
    <key key0="ج"/>
  </row>
  <!-- Hamza letters (maintainer decision 2026-10-25; 172 words of langpack-fa need them): all four
       corners of ا are taken (آ - _ ء), so أ sits on swipe-up and إ on swipe-down (hamza above /
       below); ؤ is on the top-right corner of و, where ی carries ئ. -->
  <row>
    <key key0="ش" key2="loc tab"/>
    <key key0="س"/>
    <key key0="ی" key2="ئ"/>
    <key key0="ب"/>
    <key key0="ل"/>
    <key key0="ا" key1="آ" key4="ء" key2="-" key3="_" key7="أ" key8="إ"/>
    <key key0="ت" key1="halfspace" key2="+"/>
    <key key0="ن"/>
    <key key0="م"/>
    <key key0="ک"/>
    <key key0="گ"/>
  </row>
  <row>
    <key shift="0.5" key0="ظ"/>
    <key key0="ط"/>
    <key key0="ز" key1="«" key2="»"/>
    <key key0="ر"  key1="ژ" key2="."/>
    <key key0="ذ" key2=":"/>
    <key key0="د" key2="؛"/>
    <key key0="پ" key2="&#1567;"/>
    <key key0="و" key2="ؤ"/>
    <key key0="چ"/>
    <key width="1.5" key0="backspace" key2="delete"/>
  </row>
  <!-- Own copy of res/xml/bottom_row.xml (bottom_row="false" above) so the half-space key can sit
       right of the space bar, as on AOSP, HeliBoard and FUTO (docs/research/2026-10-21-persian-zwnj.md
       §1, §7a). Keep the other keys in sync with res/xml/bottom_row.xml. Swipe up on it for ZWJ. -->
  <row height="0.95">
    <key width="1.7" key0="ctrl" key1="loc switch_greekmath" key2="loc meta" key3="loc switch_clipboard" key4="switch_numeric" key7="switch_back_clipboard"/>
    <key width="1.1" key0="fn" key1="loc alt" key2="loc change_method" key3="switch_emoji" key4="config" key7="switch_gif"/>
    <key width="4.4" key0="space" key7="loc switch_forward" key8="loc switch_backward" key5="cursor_left" key6="cursor_right"/>
    <key width="1.0" key0="halfspace" key7="zwj"/>
    <key width="1.1" key0="loc compose" key7="up" key6="right" key5="left" key8="down" key1="doc_home" key2="loc page_up" key3="doc_end" key4="loc page_down"/>
    <key width="1.7" key0="enter" key1="loc voice_typing" key2="action"/>
  </row>
</keyboard>
