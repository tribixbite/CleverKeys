+    @Test
+    fun `anything that is not an elision of a real word keeps the floor`() {
+        assertWithMessage("no apostrophe").that(elision("cetera")).isNull()
+        assertWithMessage("trailing apostrophe (a possessive)").that(elision("kids'")).isNull()
+        assertWithMessage("base not in the lexicon").that(elision("d'abaissement")).isNull()
+        assertWithMessage("en suffix shape: `t` is not a word here").that(elision("don't")).isNull()
+    }
+
+    @Test
+    fun `a raised key goes in above the floor and never below it`() {
+        val trie = trieOf("dette" to 120.0)
+        val floor = 68.0
+        val raised = mapOf("detre" to 129.0, "dabaissement" to 10.0)
+        CtcContractionKeys.inject(trie, listOf("detre", "dabaissement", "dette"), floor, raised::get)
+
+        assertThat(trie.logFrequencyOf("detre")).isWithin(1e-9).of(ln(129.0 + 1e-10))
+        assertWithMessage("a raise below the floor is ignored")
+            .that(trie.logFrequencyOf("dabaissement")).isWithin(1e-9).of(ln(floor + 1e-10))
+        assertWithMessage("a real word is still skipped, its frequency untouched")
+            .that(trie.logFrequencyOf("dette")).isWithin(1e-9).of(ln(120.0 + 1e-10))
