+    // ---- elisions ranked by their base word (maintainer 2026-11-07: "can't get d'être") ----
+
+    private val frReal = mapOf("etre" to 144.0, "ete" to 160.0)
+
+    private fun elision(display: String) =
+        CtcContractionKeys.elisionBaseFrequency(display, CtcAzProjection::project, frReal::get)
+
+    @Test
+    fun `an elision enters at its base word's frequency less the measured margin`() {
+        // The base is projected exactly as the trie was (ê → e), straight or curly apostrophe.
+        assertThat(elision("d'être")).isEqualTo(144.0 - CtcContractionKeys.ELISION_BASE_MARGIN)
+        assertThat(elision("l’été")).isEqualTo(160.0 - CtcContractionKeys.ELISION_BASE_MARGIN)
+    }
